      "docs": [
        {
          "s": "01 / INTRO",
          "t": "the oldest fossils",
          "b": "<p><span class='k'>house · water · friend · would</span> — the oldest, most-used English words are Anglo-Saxon fossils. and every bigger word? <b>built from parts like these.</b></p>"
        },
        {
          "s": "02 / DEVELOP",
          "t": "sun + set",
          "b": "<p>a word is an <span class='g'>assembly of meaning-parts</span>, not a string of sounds. sun + set = <span class='g'>sunset</span>. every letter of both survives the glue.</p>"
        },
        {
          "s": "03 / THE TWIST",
          "t": "anthill",
          "b": "<p>ant + hill. the middle looks like the sound <span class='r'>‹th›</span> — it isn't. it's a <b>t</b> and an <b>h</b> from two different words, touching at a seam.</p><p class='cluetext'>seams can lie to your eye. read the parts, not the blur.</p>"
        },
        {
          "s": "04 / YOU RUN IT",
          "t": "cat + fish → ?",
          "b": "",
          "q": {
            "p": "how many letters survive the glue?",
            "o": [
              "all of them",
              "some merge"
            ],
            "c": 0,
            "fb": "all. always. parts keep every letter."
          },
          "cue": "cat + fish — glue them, keep every letter",
          "ty": "catfish"
        }
