{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordbreak.fun/schemas/session-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "finalizedAt", "captureManifest", "objects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "captureManifest": { "type": "object", "additionalProperties": false, "required": ["name", "generation", "sha256"], "properties": { "name": { "const": "manifest/capture-manifest.json" }, "generation": { "type": "string", "pattern": "^[0-9]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "objects": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "generation", "byteCount", "sha256"], "properties": { "name": { "type": "string", "minLength": 1 }, "generation": { "type": "string", "pattern": "^[0-9]+$" }, "byteCount": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
  }
}

