{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordbreak.fun/schemas/capture-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "createdAt", "build", "eligibleDurationMs", "segments", "objects", "coverage", "captureComplete"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "build": { "type": "object", "required": ["gitSha", "bundleId", "buildNumber", "engineHash", "contentHash"], "additionalProperties": false, "properties": { "gitSha": { "$ref": "#/$defs/nonempty" }, "bundleId": { "$ref": "#/$defs/nonempty" }, "buildNumber": { "$ref": "#/$defs/nonempty" }, "engineHash": { "$ref": "#/$defs/sha256" }, "contentHash": { "$ref": "#/$defs/sha256" } } },
    "eligibleDurationMs": { "type": "integer", "minimum": 0 },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } },
    "coverage": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
    "captureComplete": { "type": "boolean" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "segment": { "type": "object", "additionalProperties": false, "required": ["segmentId", "reason", "hostAnchorNs", "firstPresentationTimeMs", "lastPresentationTimeMs", "durationMs", "discontinuities", "thermalStates"], "properties": { "segmentId": { "$ref": "#/$defs/nonempty" }, "reason": { "enum": ["start", "resume", "captureRestart", "routeChange", "relaunch"] }, "hostAnchorNs": { "type": "integer", "minimum": 0 }, "firstPresentationTimeMs": { "type": "number", "minimum": 0 }, "lastPresentationTimeMs": { "type": "number", "minimum": 0 }, "durationMs": { "type": "number", "minimum": 0 }, "discontinuities": { "type": "array", "items": { "type": "object" } }, "thermalStates": { "type": "array", "items": { "enum": ["nominal", "fair", "serious", "critical"] } } } },
    "object": { "type": "object", "additionalProperties": false, "required": ["name", "track", "segmentId", "contentType", "byteCount", "sha256"], "properties": { "name": { "type": "string", "pattern": "^raw/segments/" }, "track": { "enum": ["screen", "frontCamera", "microphone", "appAudio", "events"] }, "segmentId": { "type": ["string", "null"] }, "contentType": { "$ref": "#/$defs/nonempty" }, "byteCount": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}

